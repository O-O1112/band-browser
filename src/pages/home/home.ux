<template>
  <stack class="root">
    <!-- 主滚动区：无源流沙标准 324px 主体容器 (top: 86px) -->
    <div class="home-frame">
      <scroll class="page-scroll" scroll-y="true" bounces="true">
        <div class="inner-col">
          <!-- 无源流沙标准大圆角搜索胶囊 -->
          <div class="input-card" @click="openAddressBar('')">
            <text class="input-placeholder">输入网址或搜索...</text>
            <div class="go-pill">
              <text class="go-pill-txt">前往</text>
            </div>
          </div>

          <!-- AstroBox 状态胶囊卡片 -->
          <div class="status-card" @click="pingPlugin">
            <div class="status-left">
              <div class="dot {{online ? 'dot-on' : 'dot-off'}}"></div>
              <text class="status-txt">{{online ? 'AstroBox 实时联网' : '离线演示 · 点此检测'}}</text>
            </div>
            <text class="status-check">›</text>
          </div>

          <text class="ls-sec-label">常用网站</text>

          <!-- 无源流沙标准 324px 全宽深灰圆角列表卡片 -->
          <div
            for="{{item in shortcuts}}"
            tid="id"
            class="site-card"
            @click="openUrl(item.url)"
          >
            <div class="site-icon" style="{{ { backgroundColor: item.iconBg } }}">
              <text class="site-icon-txt" style="{{ { color: item.iconColor } }}">{{item.icon}}</text>
            </div>
            <div class="site-mid">
              <text class="site-title">{{item.label}}</text>
              <text class="site-sub">{{item.hostLabel}}</text>
            </div>
            <text class="card-arrow">›</text>
          </div>

          <text class="ls-sec-label sec-gap">书签与离线页 ({{bookmarks.length}})</text>

          <div
            for="{{bm in bookmarks}}"
            tid="url"
            class="site-card"
            @click="openUrl(bm.url)"
          >
            <div class="bm-icon">
              <text class="bm-icon-txt">W</text>
            </div>
            <div class="site-mid">
              <text class="site-title">{{bm.title}}</text>
              <text class="site-sub">{{bm.url}}</text>
            </div>
            <text class="card-arrow">›</text>
          </div>

          <div class="ls-spacer-bottom"></div>
        </div>
      </scroll>
    </div>

    <!-- 顶部无源流沙标准 72x72 圆形操作键 + 时钟/标题 -->
    <text class="time">{{nowTime}}</text>
    <text class="title">流沙浏览器</text>
    <image class="top-btn-left" src="/common/images/back_rect.png" @click="exitApp"></image>
    <image class="top-btn-right" src="/common/images/search_rect.png" @click="openAddressBar('')"></image>
  </stack>
</template>

<script>
import router from '@system.router';
import prompt from '@system.prompt';
import { QUICK_SHORTCUTS, extractHost } from '../../common/browserUtils.js';

const ICON_THEME = {
  wiki: { bg: '#1B365D', color: '#64B5F6' },
  bing: { bg: '#163D34', color: '#4ADE80' },
  ddg: { bg: '#422B12', color: '#FBBF24' },
  vela: { bg: '#421932', color: '#F472B6' },
  hn: { bg: '#442312', color: '#FB923C' },
  rss: { bg: '#2C214A', color: '#A78BFA' },
};

function decorateShortcuts() {
  return QUICK_SHORTCUTS.map((item) => {
    const theme = ICON_THEME[item.id] || { bg: '#1B365D', color: '#64B5F6' };
    return {
      ...item,
      iconBg: theme.bg,
      iconColor: theme.color,
      hostLabel: extractHost(item.url),
    };
  });
}

function formatNow() {
  const d = new Date();
  const hh = String(d.getHours()).padStart(2, '0');
  const mm = String(d.getMinutes()).padStart(2, '0');
  return `${hh}:${mm}`;
}

export default {
  private: {
    nowTime: formatNow(),
    online: false,
    shortcuts: decorateShortcuts(),
    bookmarks: [],
  },
  onInit() {
    const client = this.$app.$def.getBrowserClient();
    this._unsubStatus = client.subscribeStatus((isOnline) => {
      this.online = isOnline;
    });
    this.syncState();
  },
  onDestroy() {
    if (this._unsubStatus) this._unsubStatus();
  },
  onShow() {
    this.nowTime = formatNow();
    this.syncState();
  },
  async syncState() {
    const client = this.$app.$def.getBrowserClient();
    const [bms, isOnline] = await Promise.all([
      client.getBookmarks(),
      client.checkOnline(),
    ]);
    this.bookmarks = bms;
    this.online = isOnline;
  },
  async pingPlugin() {
    const client = this.$app.$def.getBrowserClient();
    const ok = await client.checkOnline();
    this.online = ok;
    prompt.showToast({
      message: ok ? 'AstroBox 插件通道正常' : '未连接 AstroBox，当前为离线演示',
    });
  },
  openAddressBar(prefill) {
    this.$app.$def.setPendingInput(prefill || '');
    router.push({ uri: 'pages/address' });
  },
  openUrl(url) {
    router.push({
      uri: 'pages/reader',
      params: { url },
    });
  },
  exitApp() {
    router.back();
  },
};
</script>

