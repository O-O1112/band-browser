{
  "package": "io.github.o_o1112.bandbrowser",
  "name": "流沙浏览器",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.router" },
    { "name": "system.storage" },
    { "name": "system.interconnect" },
    { "name": "system.vibrator" },
    { "name": "system.prompt" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 336
  },
  "router": {
    "entry": "pages/home",
    "pages": {
      "pages/home": {
        "component": "home"
      },
      "pages/reader": {
        "component": "reader"
      },
      "pages/address": {
        "component": "address"
      }
    }
  }
}
